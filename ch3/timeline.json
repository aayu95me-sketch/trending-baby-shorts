{
 "total": 80.656,
 "voice": "long-gta6-hisaab/ch3/voice.wav",
 "lines": [
  {
   "start": 0.185,
   "text": "Chapter do. Console ka kharcha.",
   "end": 3.068
  },
  {
   "start": 3.068,
   "text": "GTA six sirf do console pe hai: PS5 aur Xbox Series X aur S. PS4 aur Xbox One pe nahi chalega. PC version abhi announce hi nahi hua.",
   "end": 13.584
  },
  {
   "start": 13.584,
   "text": "Ab PS5 ke daam dekho. Amazon India pe October ke aakhir mein PS5 Slim digital ₹64,990 ka tha, aur disc wala ₹69,985 ka.",
   "end": 24.631
  },
  {
   "start": 24.631,
   "text": "Aur ye wahi PS5 hai jo kuch time pehle ₹54,990 ka milta tha. Matlab disc wala lagbhag 27% mehenga ho chuka hai. Sony ne wajah batayi manufacturing, memory aur storage ki badhti keemat.",
   "end": 37.13
  },
  {
   "start": 37.13,
   "text": "Ab jodo. Digital PS5 plus Standard game: ₹70,989 . Disc PS5 plus Standard: ₹75,984 .",
   "end": 46.229
  },
  {
   "start": 46.811,
   "text": "Yahan hai hook wala twist. Disc drive ke liye aap ₹4,995 extra de rahe ho. Lekin GTA six ke dabbe mein disc hai hi nahi. Toh agar aap sirf GTA ke liye PS5 le rahe ho, to disc drive pe paanch hazaar lagaana zaroori nahi.",
   "end": 58.786
  },
  {
   "start": 58.951,
   "text": "Haan, agar aap purani discs khelte ho, ya game bech ke paise wapas lena chahte ho, to disc wala kaam ka hai. Faisla aapka, lekin ab hisaab saamne hai.",
   "end": 67.82
  },
  {
   "start": 67.82,
   "text": "Aur Xbox? Microsoft ne is saal duniya bhar mein Xbox ke daam badhaaye. Series S ab America mein paanch sau dollar ke upar hai. India ka naya daam humein kisi pakke source mein nahi mila, isliye hum andaaza nahi lagayenge.",
   "end": 79.259
  }
 ],
