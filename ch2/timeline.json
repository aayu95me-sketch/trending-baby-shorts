{
 "total": 81.595,
 "voice": "long-ramayana-hisaab/ch2/voice.wav",
 "lines": [
  {
   "start": 0.247,
   "text": "Chapter ek. Ab tak kitna kamaya.",
   "end": 2.274
  },
  {
   "start": 2.798,
   "text": "Film paanch November ko aayi. Director Nitesh Tiwari, aur Ranbir Kapoor, Yash, Sai Pallavi.",
   "end": 8.401
  },
  {
   "start": 8.982,
   "text": "Teen din yaad rakhne layak hain. Pehla: opening day, India mein 64.85 crore net.",
   "end": 16.352
  },
  {
   "start": 16.425,
   "text": "Doosra: nau November, Diwali ke agle din ka Monday. 107.5 crore. Ek din mein. Ye film ka ab tak ka sabse bada din hai. Pehle aath din mein India net 564.6 crore.",
   "end": 28.663
  },
  {
   "start": 28.663,
   "text": "Teesra, aur sabse zaroori: doosra weekend. Asli test wahi hota hai, jab tyohaar ka josh utar jaata hai. Ramayana ne doosre Friday, Saturday, Sunday mein 196 crore aur kamaaye. Matlab log sirf Diwali ki chhutti mein nahi, recommendation sunke bhi aa rahe the.",
   "end": 43.389
  },
  {
   "start": 43.708,
   "text": "Phir Monday 32 aur Tuesday 28.7 . Yahan pehli baar film dheemi hui. Chhutiyaan khatam, school aur office wapas.",
   "end": 51.68
  },
  {
   "start": 51.68,
   "text": "Terah din ka total: India net 821 crore, India gross 981.5 crore, videsh se 502 crore. Worldwide, kul milake 1,483 crore.",
   "end": 66.126
  },
  {
   "start": 66.126,
   "text": "Ek cheez yaad rakhna, aage kaam aayegi. Gross matlab ticket ka poora paisa. Net matlab usme se GST nikal ke. Aur jo paisa producer tak pahunchta hai, wo in dono se kaafi kam hota hai. Wo hisaab chapter paanch mein.",
   "end": 80.056
  }
 ],
