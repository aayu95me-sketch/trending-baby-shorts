{
 "total": 35.679,
 "voice": "20261123-gratuity-1-saal/voice.wav",
 "lines": [
  {
   "start": 0.25,
   "text": "Gratuity ab ek saal mein milegi? Sach yeh hai, sabko nahi.",
   "end": 3.596
  },
  {
   "start": 4.02,
   "text": "Naye labour code mein ek saal wala rule sirf fixed term employees ke liye hai.",
   "end": 7.482
  },
  {
   "start": 7.914,
   "text": "Matlab jinhe contract pe tay muddat ke liye rakha gaya, unhe ek saal baad bhi gratuity milegi.",
   "end": 13.32
  },
  {
   "start": 13.32,
   "text": "Permanent employee? Unke liye ab bhi paanch saal ka hi rule hai.",
   "end": 16.049
  },
  {
   "start": 16.6,
   "text": "Hisaab simple hai. Pandrah din ki salary, guna saal, chhabbees se bhaag.",
   "end": 20.698
  },
  {
   "start": 21.074,
   "text": "Basic aur DA tees hazaar hai, toh ek saal ki gratuity lagbhag satrah hazaar.",
   "end": 24.556
  },
  {
   "start": 24.82,
   "text": "Aur naya twist. Basic aur DA ab total salary ka kam se kam aadha maane jaate hain, toh gratuity badh sakti hai.",
   "end": 30.622
  },
  {
   "start": 30.991,
   "text": "Aap fixed term ho ya permanent? Comment mein ek word likho.",
   "end": 34.286
  }
 ],
