{
 "total": 44.982,
 "voice": "20261125-sooryavanshi-204/voice.wav",
 "lines": [
  {
   "start": 0.273,
   "text": "Pandrah saal ka ladka, tirpan gendon mein do sau chaar. Par kya ye ODI world record hai?",
   "end": 4.903
  },
  {
   "start": 5.262,
   "text": "Doha mein UAE ne do sau pachaas ka target diya. India A ne pandrah over se pehle match khatam.",
   "end": 10.027
  },
  {
   "start": 10.406,
   "text": "Vaibhav Sooryavanshi ne atthaais chhakke maare. Chauke sirf saat.",
   "end": 13.896
  },
  {
   "start": 13.998,
   "text": "Sau run sirf atthaais gendon mein. Pichhla record unatees gendon ka tha.",
   "end": 17.91
  },
  {
   "start": 18.235,
   "text": "Double century bawan gendon mein. Pichhla record ek sau teen ka. Aadhe se bhi kam.",
   "end": 22.501
  },
  {
   "start": 22.864,
   "text": "Ab asli sawaal. Kya ye ODI record book mein jaayega?",
   "end": 25.359
  },
  {
   "start": 25.747,
   "text": "Nahi jaayega. India A ODI team nahi hai. Ye List A match tha.",
   "end": 29.076
  },
  {
   "start": 29.237,
   "text": "ODI ka sabse tez sau abhi bhi AB de Villiers ka hai, iktees gendon mein.",
   "end": 33.278
  },
  {
   "start": 33.658,
   "text": "Par List A, yaani pachaas over cricket ka world record, pakka Vaibhav ka. Sau bhi, do sau bhi.",
   "end": 39.749
  },
  {
   "start": 40.095,
   "text": "Pandrah saal mein senior India team mein lo? Haan ya na, comment karo.",
   "end": 43.536
  }
 ],
