{
 "total": 42.425,
 "voice": "20261123-ind-a-vs-pak-a/voice.wav",
 "lines": [
  {
   "start": 0.17,
   "text": "Tilak Varma ne century maari, phir bhi India A Pakistan A se haar gaya. Galti Tilak ki?",
   "end": 4.96
  },
  {
   "start": 4.96,
   "text": "Pakistan A ne banaye teen sau terah. India A do sau painsath pe all out, adtaalees run se haar.",
   "end": 10.889
  },
  {
   "start": 11.26,
   "text": "Abhishek Sharma ne bayaalees ball pe sattar maare, lekin phir ek sau chaubees pe paanch wicket gir gaye.",
   "end": 16.35
  },
  {
   "start": 16.611,
   "text": "Tilak ne sau run banaye, par ek sau unchaas ball khel kar.",
   "end": 19.998
  },
  {
   "start": 20.372,
   "text": "Hisaab dekho. Har ball pe ek run se zyada chahiye tha, Tilak ka strike rate sirf sadsath raha.",
   "end": 25.512
  },
  {
   "start": 25.658,
   "text": "Shahbaz Ahmed ne unchaas ball pe chhappan maare, par target bahut door tha.",
   "end": 29.701
  },
  {
   "start": 29.807,
   "text": "Toh sach kya hai? Haar sirf Tilak ki wajah se nahi, top order bhi gira. Lekin itne bade chase mein yeh speed kam padi.",
   "end": 36.9
  },
  {
   "start": 36.9,
   "text": "Aapke hisaab se Tilak sahi ya slow? Comment mein ek word likho.",
   "end": 41.006
  }
 ],
