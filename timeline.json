  {
   "start": 0.279,
   "text": "India 89 par all out. Toh kya series haath se gayi?",
   "end": 3.066
  },
  {
   "start": 3.56,
   "text": "Nahi bilkul nahi. Haar badi hai, 244 RUN se. Par series abhi bhi India ki taraf.",
   "end": 9.12
  },
  {
   "start": 9.12,
   "text": "Will Young ki century, aur Matt Henry ke 6 WICKET ne India ko tod diya.",
   "end": 13.56
  },
  {
   "start": 13.56,
   "text": "Lekin India yeh series haar hi nahi sakta. 2-1 se aage hai.",
   "end": 16.556
  },
  {
   "start": 16.88,
   "text": "Sunday ko New Zealand jeeta, toh bhi series sirf barabar hogi.",
   "end": 19.608
  },
  {
   "start": 19.98,
   "text": "Jo bole series gayi, use yeh bhejo.",
   "end": 21.905
  }
 ],
