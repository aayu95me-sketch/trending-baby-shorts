{
 "total": 39.523,
 "voice": "20261120-ps5-price-hike/voice.wav",
 "lines": [
  {
   "start": 0.118,
   "text": "Bhai dekh, PS5 pe GTA 6! Par yeh PS5 isi mahine pandrah hazaar mehenga hua. Kyun?",
   "end": 5.898
  },
  {
   "start": 6.3,
   "text": "Terah saal ke intezaar ke baad Rockstar ka naya GTA. Vice City wapas, do hero, Lucia aur Jason.",
   "end": 12.04
  },
  {
   "start": 12.04,
   "text": "Aur PS5 pe four K graphics, aur SSD itni tez ki loading screen dikhti hi nahi.",
   "end": 17.5
  },
  {
   "start": 17.5,
   "text": "Ab daam. PS5 pachpan hazaar se seedha sattar hazaar ka ho gaya.",
   "end": 21.32
  },
  {
   "start": 21.32,
   "text": "GTA ki wajah se nahi. Memory aur storage mehengi hui, US, UK, Japan mein bhi daam badhe.",
   "end": 26.565
  },
  {
   "start": 26.94,
   "text": "Game milaake lagbhag chhihattar hazaar. Sirf hike ke paison mein GTA ki dhai copies aa jaati.",
   "end": 32.23
  },
  {
   "start": 32.614,
   "text": "Tu lega ya wait karega? Us dost ko bhej jo bolta tha GTA aate hi PS5 uthaunga.",
   "end": 38.044
  }
 ],
