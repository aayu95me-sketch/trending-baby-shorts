 "lines": [
  {
   "start": 0.323,
   "text": "Ramayana ne paanch din mein kitna kamaaya? Kya ₹4,000 crore wapas aayenge?",
   "end": 4.356
  },
  {
   "start": 4.75,
   "text": "Monday sabse bada din, shaam saat baje tak ₹81 crore net.",
   "end": 8.54
  },
  {
   "start": 8.54,
   "text": "Paanch din ka India net, lagbhag ₹320 crore . Duniya bhar mein chaar din mein ₹507 crore gross.",
   "end": 14.1
  },
  {
   "start": 14.1,
   "text": "Lekin... sach yeh hai, chaar hazaar crore dono parts ka combined budget hai.",
   "end": 18.24
  },
  {
   "start": 18.24,
   "text": "Toh kya Ramayana chaar hazaar crore paar karegi? Haan ya naa, comment karo.",
   "end": 23.224
  }
 ],
