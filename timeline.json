 "lines": [
  {
   "start": 0.155,
   "text": "India Maldives se jeet gaya, par kya semi final pakka hua?",
   "end": 3.281
  },
  {
   "start": 3.871,
   "text": "Bilkul pakka. SAFF Championship mein India ne Maldives ko 1-0 se haraya.",
   "end": 8.774
  },
  {
   "start": 9.078,
   "text": "Goal penalty se aaya. Suhail Bhat ka is tournament mein teesra goal.",
   "end": 12.232
  },
  {
   "start": 12.232,
   "text": "India apne group mein top par, poore 6 points ke saath.",
   "end": 15.8
  },
  {
   "start": 15.8,
   "text": "Aakhri minuton mein Maldives ne poora zor lagaya, par goalkeeper Priyansh Dubey ne jeet bacha li.",
   "end": 20.552
  },
  {
   "start": 20.922,
   "text": "Semi final 14 NOV ko. Jo bole India bahar hai, use yeh bhejo.",
   "end": 24.665
  }
 ],
