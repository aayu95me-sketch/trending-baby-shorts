 "lines": [
  {
   "start": 0.275,
   "text": "Kolkata se Mumbai ja rahi Air India flight hijack ho gayi?",
   "end": 3.007
  },
  {
   "start": 3.406,
   "text": "Bilkul nahi. Take off se pehle flight ke toilet mein ek hijack ki dhamki wala note mila.",
   "end": 7.674
  },
  {
   "start": 8.02,
   "text": "Sabhi 105 yatri utaare gaye.",
   "end": 9.393
  },
  {
   "start": 9.68,
   "text": "Jaanch ke baad officials ne bataya, yeh dhamki jhoothi thi. Hoax.",
   "end": 13.357
  },
  {
   "start": 13.748,
   "text": "Lekin pichhle mahine bhi Kolkata airport par do jhoothi dhamkiyan aayi thi.",
   "end": 16.65
  },
  {
   "start": 17.052,
   "text": "Jo bole hijack hua, use yeh bhejo.",
   "end": 18.904
  }
 ],
