{
 "total": 41.939,
 "voice": "20261126-hycross-facelift-price/voice.wav",
 "lines": [
  {
   "start": 0.0,
   "text": "Innova Hycross facelift, unees lakh unsath hazaar rupaye mein. Kya is daam mein hybrid milega?",
   "end": 5.162
  },
  {
   "start": 5.52,
   "text": "Nahi milega. Ye daam sirf petrol GX ka hai.",
   "end": 8.288
  },
  {
   "start": 8.64,
   "text": "Hybrid shuru hota hai unees lakh ninyanve hazaar se. Yaani chaalees hazaar zyada.",
   "end": 13.002
  },
  {
   "start": 13.18,
   "text": "Sabse upar wala ZX hybrid, iktees lakh ninyanve hazaar rupaye ka.",
   "end": 17.125
  },
  {
   "start": 17.472,
   "text": "Aur ye hybrid pachaasi percent ethanol, yaani E85 pe bhi chalega. Par ye fuel milega kahan?",
   "end": 23.5
  },
  {
   "start": 23.5,
   "text": "June mein adtaalees pumps se shuru hua. Target hai December tak paanch sau.",
   "end": 27.86
  },
  {
   "start": 27.86,
   "text": "E85 petrol se lagbhag bees rupaye sasta. Par ethanol mein mileage thoda kam aata hai.",
   "end": 32.438
  },
  {
   "start": 32.804,
   "text": "Toh hybrid chahiye toh budget bees lakh rakho. E85 ka fayda tabhi, jab pump aapke shehar mein ho.",
   "end": 37.974
  },
  {
   "start": 38.4,
   "text": "Aap kaunsa loge, petrol ya hybrid? Comment karo.",
   "end": 40.548
  }
 ],
