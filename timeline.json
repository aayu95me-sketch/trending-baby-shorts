{
 "total": 40.386,
 "voice": "20261121-voyager-light-day/voice.wav",
 "lines": [
  {
   "start": 0.313,
   "text": "Unnees sau satattar mein bheja yaan. Aaj usse hello bolo, toh jawab do din baad aayega. Sach?",
   "end": 5.785
  },
  {
   "start": 6.005,
   "text": "Haan sach. NASA ne confirm kiya, Voyager one ab Earth se ek light day door hai.",
   "end": 11.776
  },
  {
   "start": 12.153,
   "text": "Matlab roshni, jo ek second mein dharti ke saat se zyada chakkar laga leti hai, usse bhi wahan pahunchne mein poora ek din lagta hai.",
   "end": 18.619
  },
  {
   "start": 19.02,
   "text": "Doori lagbhag chhabbees arab kilometre. Insaan ki banayi sabse door ki cheez.",
   "end": 23.64
  },
  {
   "start": 23.64,
   "text": "Aur yeh unchaas saal se chal raha hai, aaj bhi Earth ko signal bhejta hai.",
   "end": 27.719
  },
  {
   "start": 28.111,
   "text": "Par bijli kam ho rahi hai, isliye NASA ek ek karke iske instrument band kar raha hai.",
   "end": 32.704
  },
  {
   "start": 33.097,
   "text": "Ek din late pahunchne wala message, aap kise bhejoge? Us dost ko tag karo jo late reply karta hai.",
   "end": 38.926
  }
 ],
