 "lines": [
  {
   "start": 0.237,
   "text": "Ramayana ne Jawan ko peeche chhod diya? Sach kya hai?",
   "end": 3.585
  },
  {
   "start": 3.86,
   "text": "India mein haan. Ramayana ki India gross kamai 783 CR paar.",
   "end": 8.019
  },
  {
   "start": 8.209,
   "text": "Jawan ki poori India gross kamai thi 762 CR . Sirf das din mein record gaya.",
   "end": 12.898
  },
  {
   "start": 13.136,
   "text": "Lekin worldwide par abhi kaanta takkar hai.",
   "end": 15.581
  },
  {
   "start": 15.908,
   "text": "Jawan ne duniya bhar mein 1148 CR kamaye the.",
   "end": 18.798
  },
  {
   "start": 19.112,
   "text": "Ramayana ke aankde source ke hisaab se thode upar ya thode neeche hain. Yeh weekend faisla karega.",
   "end": 24.304
  },
  {
   "start": 24.667,
   "text": "Aapke hisaab se bada kaun, Ramayana ya Jawan? Comment karo.",
   "end": 27.925
  }
 ],
