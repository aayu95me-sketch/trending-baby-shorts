 "lines": [
  {
   "start": 0.171,
   "text": "Yeh kohra hai ya zeher? Har November Dilli mein hi kyun?",
   "end": 3.535
  },
  {
   "start": 3.932,
   "text": "Smog yaani smoke aur fog. Dhuaan aur kohra, ek saath.",
   "end": 7.615
  },
  {
   "start": 7.625,
   "text": "Sardi mein thandi hawa zameen ke paas phans jaati hai. Upar garam hawa dhakkan ban jaati hai, dhuaan bahar nahi nikalta.",
   "end": 13.804
  },
  {
   "start": 14.2,
   "text": "Aur Diwali ke din 1248 jagah parali jali. Pichhle saal sirf 135 .",
   "end": 19.712
  },
  {
   "start": 20.092,
   "text": "London mein ek baar smog ne kareeb 12000 jaanein li thi. Tab jaakar kanoon bana.",
   "end": 24.398
  },
  {
   "start": 24.788,
   "text": "Dilli mein 15 November tak baarish nahi. Jo bole sirf kohra hai, use bhejo.",
   "end": 28.993
  }
 ],
