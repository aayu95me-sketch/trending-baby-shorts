 "lines": [
  {
   "start": 0.0,
   "text": "Vivo X five hundred India mein aaya, ek lakh unnees hazaar rupaye se. Par sabse mehenga wala kitne ka?",
   "end": 5.331
  },
  {
   "start": 5.574,
   "text": "Sabse sasta X five hundred, baarah GB aur do sau chhappan GB, ek lakh unnees hazaar rupaye.",
   "end": 10.275
  },
  {
   "start": 10.6,
   "text": "Uske upar X five hundred Pro, ek lakh unchaas hazaar rupaye.",
   "end": 14.004
  },
  {
   "start": 14.398,
   "text": "Phir Pro Max, ek lakh chausath hazaar rupaye se shuru.",
   "end": 17.151
  },
  {
   "start": 17.524,
   "text": "Aur sabse mehenga, Pro Max photography kit. Do lakh untees hazaar rupaye. Isme phone ke saath do ZEISS lens aate hain.",
   "end": 24.182
  },
  {
   "start": 24.586,
   "text": "Farak kya hai? Pro Max mein do sau megapixel ka telephoto. Baaki dono mein sirf chausath.",
   "end": 29.194
  },
  {
   "start": 29.566,
   "text": "Bank card pe das percent tak discount. Pre-booking aaj se, sale teen December se.",
   "end": 34.232
  },
  {
   "start": 34.584,
   "text": "Toh sabse sasta bhi ek lakh se upar. Aur poora kit, do lakh se upar.",
   "end": 38.376
  },
  {
   "start": 38.741,
   "text": "Aap kaunsa loge, vivo ya iPhone? Comment mein batao.",
   "end": 41.401
  }
 ],
