{"total": 37.886, "voice": "20261124-wtc-india-final/voice.wav", "lines": [{"start": 0.245, "text": "Saat sau bees run banaye, phir bhi jeet nahi. Kya India WTC final se bahar?", "end": 4.806}, {"start": 5.06, "text": "Wellington Test draw hua. New Zealand ne doosri innings mein ek sau bees over khele, sirf paanch wicket gire.", "end": 10.28}, {"start": 10.62, "text": "Table mein India ab chauthe number pe hai, pachaas percent pe.", "end": 13.367}, {"start": 13.367, "text": "Ab India ke chhe Test bache hain. Ek New Zealand mein, paanch ghar pe Australia se.", "end": 17.46}, {"start": 17.46, "text": "Hisaab dekho. Chhe ke chhe jeete, toh India lagbhag sadsath percent tak pahunch sakta hai.", "end": 21.819}, {"start": 21.96, "text": "Pichhle do final mein doosre number wali team unsath aur chausath percent pe thi.", "end": 25.786}, {"start": 26.152, "text": "Matlab India bahar nahi hua. Par ab har Test final jaisa hai. Ek haar chal sakti hai, do nahi.", "end": 32.64}, {"start": 32.64, "text": "Christchurch Test sattaais November se. India jeetega? Haan ya na, comment karo.", "end": 36.594}], "words": [{"w": "Saat", "start": 0.245, "end": 0.47}, {"w": "sau", "start": 0.49, "end": 0.715}, {"w": "bees", "start": 0.735, "end": 0.96}, {"w": "run", "start": 0.98, "end": 1.28}, {"w": "banaye,", "start": 1.3, "end": 1.723}, {"w": "phir", "start": 1.743, "end": 2.0}, {"w": "bhi", "start": 2.02, "end": 2.1}, {"w": "jeet", "start": 2.12, "end": 2.38}, {"w": "nahi.", "start": 2.4, "end": 2.8}, {"w": "Kya", "start": 2.82, "end": 3.02}, {"w": "India", "start": 3.04, "end": 3.48}, {"w": "WTC", "start": 3.5, "end": 4.0}, {"w": "final", "start": 4.02, "end": 4.34}, {"w": "se", "start": 4.36, "end": 4.48}, {"w": "bahar?", "start": 4.5, "end": 5.04}, {"w": "Wellington", "start": 5.06, "end": 5.6}, {"w": "Test", "start": 5.62, "end": 5.84}, {"w": "draw", "start": 5.86, "end": 6.12}, {"w": "hua.", "start": 6.14, "end": 6.62}, {"w": "New", "start": 6.64, "end": 6.82}, {"w": "Zealand", "sta