 "lines": [
  {
   "start": 0.0,
   "text": "India A ne teen sau satrah banaye. Phir bhi aath wicket se haar gaye. Kaise?",
   "end": 4.585
  },
  {
   "start": 4.876,
   "text": "Pehle India A. Abhishek Sharma athhattar, aur Tilak Varma, Shahbaz Ahmed ki fifty.",
   "end": 9.22
  },
  {
   "start": 9.22,
   "text": "Phir Sri Lanka A ke dono openers ne century maar di.",
   "end": 13.412
  },
  {
   "start": 13.412,
   "text": "Sineth Jayawardena, sirf sattar gend mein ek sau paanch.",
   "end": 16.008
  },
  {
   "start": 16.146,
   "text": "Lasith Croospulle ne ek sau solah run banaye.",
   "end": 18.775
  },
  {
   "start": 19.168,
   "text": "Target tha teen sau atharah. Sri Lanka ne iktalees over mein hi bana diya.",
   "end": 22.933
  },
  {
   "start": 23.24,
   "text": "Matlab poore match mein India A ke bowler sirf do wicket le paaye.",
   "end": 26.346
  },
  {
   "start": 26.748,
   "text": "Ab final mein Sri Lanka A, unatees November ko. Saamne hoga Pakistan ya Bangladesh.",
   "end": 31.54
  },
  {
   "start": 31.923,
   "text": "Aap batao, teen sau satrah kam pade, ya bowling kamzor thi? Comment karo.",
   "end": 36.194
  }
 ],
