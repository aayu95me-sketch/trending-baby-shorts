 "lines": [
  {
   "start": 0.34,
   "text": "GTA 6 khelna hai? Pehle India mein iska asli kharcha samjho.",
   "end": 4.187
  },
  {
   "start": 4.44,
   "text": "India mein 19 November ko raat baarah baje unlock hota hai.",
   "end": 7.472
  },
  {
   "start": 7.828,
   "text": "Game ka standard edition PlayStation Store pe lagbhag chhe hazaar rupaye.",
   "end": 11.64
  },
  {
   "start": 11.64,
   "text": "Lekin PS5 ab India mein lagbhag 70 hazaar ka hai.",
   "end": 14.546
  },
  {
   "start": 14.851,
   "text": "Matlab PS5 nahi hai, toh game aur console milaakar chhihattar hazaar ke aas paas.",
   "end": 18.836
  },
  {
   "start": 18.85,
   "text": "PC wale ruko, PC pe abhi nahi aaya. PS4 pe bhi nahi. Sirf PS5 aur Xbox Series pe.",
   "end": 25.616
  },
  {
   "start": 26.12,
   "text": "Space bhi dekho, download ke liye do sau GB se zyada jagah chahiye.",
   "end": 29.801
  },
  {
   "start": 30.204,
   "text": "Aap abhi khareedoge, ya PC ka wait karoge? Comment karo, aur us dost ko bhejo jo PS4 pe chalane ka soch raha tha.",
   "end": 36.301
  }
 ],
