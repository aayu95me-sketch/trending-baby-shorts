 "lines": [
  {
   "start": 0.0,
   "text": "America ki commission USCIRF ne kaha, Sharjeel Imam religious freedom ki awaaz uthane ki wajah se jail mein hain. Sach kya hai?",
   "end": 6.537
  },
  {
   "start": 6.8,
   "text": "India ke rajdoot Vinay Kwatra ne jawab diya, USCIRF ko Indian nagrikon ke adhikaaron par faisla sunane ka koi haq nahi.",
   "end": 12.733
  },
  {
   "start": 13.096,
   "text": "Toh Sharjeel jail mein kyun hain? January 2020 se woh Delhi dangon ki badi saazish wale UAPA case mein band hain.",
   "end": 18.819
  },
  {
   "start": 19.013,
   "text": "Supreme Court ne is saal January mein unki bail thukra di. Court ne saazish mein unka role central bataya.",
   "end": 23.934
  },
  {
   "start": 24.109,
   "text": "Lekin abhi tak kisi bhi case mein unhe doshi nahi thehraaya gaya. Woh undertrial hain.",
   "end": 27.778
  },
  {
   "start": 28.036,
   "text": "Matlab jail ki wajah court record mein UAPA case hai. Aakhri faisla abhi baaki hai.",
   "end": 33.121
  },
  {
   "start": 33.254,
   "text": "Aap kiski baat se sehmat ho, USCIRF ya India? Comment karo.",
   "end": 37.57
  }
 ],
