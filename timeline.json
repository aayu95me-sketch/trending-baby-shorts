{
 "total": 37.436,
 "voice": "20261121-india-a-nepal-26/voice.wav",
 "lines": [
  {
   "start": 0.212,
   "text": "India A ne banaye teen sau battees. Nepal? Sirf chhabbees pe all out. Yeh record hai ya mazaak?",
   "end": 5.987
  },
  {
   "start": 6.06,
   "text": "Doha mein Asia Cup Rising Stars, pachaas over ka match. Tilak Varma aur Kumar Kushagra, dono ki century.",
   "end": 12.461
  },
  {
   "start": 12.839,
   "text": "Phir Nepal sirf gyarah over tika. Paanch batsman zero pe out, captain Lamichhane bhi.",
   "end": 17.93
  },
  {
   "start": 18.296,
   "text": "Prince Yadav ne sirf chhe run dekar paanch wicket liye. Harshit Rana ke chaar.",
   "end": 21.804
  },
  {
   "start": 21.87,
   "text": "Toh record hai? Haan. Teen sau chhe run, India A ki List A mein sabse badi jeet.",
   "end": 27.467
  },
  {
   "start": 27.775,
   "text": "Aur chhabbees, List A itihaas ka paanchwa sabse chhota score.",
   "end": 31.534
  },
  {
   "start": 31.932,
   "text": "Nepal itna kamzor, ya India A itni khatarnak? Comment mein ek word likho.",
   "end": 36.041
  }
 ],
