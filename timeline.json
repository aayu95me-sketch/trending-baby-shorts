{
 "total": 43.859,
 "voice": "20261121-gold-crash/voice.wav",
 "lines": [
  {
   "start": 0.225,
   "text": "Das din mein sona gyarah hazaar sasta! Ab kharidein, ya aur girega?",
   "end": 4.011
  },
  {
   "start": 4.276,
   "text": "Das November ko chaubees carat, das gram, ek lakh chawaalees hazaar ka tha. Bees November ko ek lakh taintees hazaar.",
   "end": 10.735
  },
  {
   "start": 11.066,
   "text": "Duniya mein sona chaudah mahine ke sabse neeche bhaav pe. January ke peak se tees percent neeche.",
   "end": 16.557
  },
  {
   "start": 16.663,
   "text": "Kyun gira? Pehli wajah, dollar mazboot hai.",
   "end": 19.424
  },
  {
   "start": 19.8,
   "text": "Doosri America mein byaaj dar badhne ki ummeed. Byaaj badhe toh sona rakhne ka fayda kam lagta hai.",
   "end": 24.788
  },
  {
   "start": 25.156,
   "text": "Teesri AI aur tech shares gire, toh bade investors ne nuksaan bharne ke liye sona becha.",
   "end": 29.78
  },
  {
   "start": 29.78,
   "text": "Toh kya karein? Shaadi ke liye lena hai toh ek saath nahi, thoda thoda lo. Jaldi paisa banane ke liye, ruko. Yeh advice nahi, sirf hisaab hai.",
   "end": 38.98
  },
  {
   "start": 38.98,
   "text": "Aap abhi loge ya wait? Us dost ko bhejo jo sona lene wala tha.",
   "end": 42.318
  }
 ],
