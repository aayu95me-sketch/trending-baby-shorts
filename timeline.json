 "lines": [
  {
   "start": 0.0,
   "text": "Rohit Sharma phir se Mumbai Indians ke captain. Toh Hardik kahan gaye?",
   "end": 3.387
  },
  {
   "start": 3.66,
   "text": "Hardik Pandya ab Punjab Kings mein. Badle mein MI ko mile Arshdeep Singh.",
   "end": 7.238
  },
  {
   "start": 7.616,
   "text": "Kyun badla? Hardik ke pehle hi season mein MI sabse neeche, dasve number pe.",
   "end": 12.005
  },
  {
   "start": 12.165,
   "text": "Aur teen season mein playoffs sirf ek baar.",
   "end": 14.403
  },
  {
   "start": 14.62,
   "text": "Rohit ki captaincy mein MI ne paanch IPL trophy jeeti. Dhoni ke barabar.",
   "end": 18.32
  },
  {
   "start": 18.513,
   "text": "Ab unchaalees saal ki umar mein, MI ke beesve season mein, Rohit phir captain.",
   "end": 22.66
  },
  {
   "start": 22.73,
   "text": "Aap batao, sahi faisla ya bahut der se? Comment karo.",
   "end": 26.151
  }
 ],
