 "voice": "20261116-starship-catch/voice.wav",
 "lines": [
  {
   "start": 0.195,
   "text": "Space se lauta rocket, aur tower ne use hawa mein pakad liya? Sach hai ya AI?",
   "end": 5.441
  },
  {
   "start": 5.609,
   "text": "Sach hai. SpaceX ne Starship ka upar wala hissa tower ki chopstick jaisi baahon se pakda.",
   "end": 9.826
  },
  {
   "start": 9.965,
   "text": "Duniya mein pehli baar orbit se laute kisi rocket ke upper stage ko aise pakda gaya.",
   "end": 13.905
  },
  {
   "start": 14.113,
   "text": "Ship ne dharti ke 14 chakkar lagaaye, aur lagbhag saadhe baais ghante baad lauta.",
   "end": 17.636
  },
  {
   "start": 18.001,
   "text": "Lekin neeche wala booster nahi pakda gaya. Fuel kam ka alarm aaya, aur woh samandar mein gira.",
   "end": 21.875
  },
  {
   "start": 22.053,
   "text": "Kyun zaroori hai? Ab yeh rocket phenka nahi jaayega, dobara udega. Isi se launch sasta hoga.",
   "end": 26.716
  },
  {
   "start": 27.061,
   "text": "Aapko pehli baar dekh kar kya laga, asli ya CGI? Comment karo.",
   "end": 30.221
  }
 ],
