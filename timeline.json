 "lines": [
  {
   "start": 0.15,
   "text": "Aakhri ball, 3 RUN chahiye, sirf ek wicket baaki. India jeeta ya haara?",
   "end": 4.727
  },
  {
   "start": 5.12,
   "text": "Jeeta India. Mohit Ulva ne aakhri ball par chauka maara.",
   "end": 8.485
  },
  {
   "start": 8.862,
   "text": "Pakistan ne final mein 337 banaye the. Itna bada chase kaise hua?",
   "end": 12.83
  },
  {
   "start": 13.06,
   "text": "Captain Lakshya ne 80 banaye, aur Sehwag ke bete Aaryavir ne 58 .",
   "end": 16.665
  },
  {
   "start": 16.782,
   "text": "Lekin ek samay 86 RUN chahiye the, aur sirf do wicket bache the.",
   "end": 20.275
  },
  {
   "start": 20.662,
   "text": "Tab Ulva ne 26 ball par naabad 49 thok diye.",
   "end": 23.293
  },
  {
   "start": 23.293,
   "text": "Pichhle saal isi final mein Pakistan jeeta tha. Badla poora hua? Comment karo.",
   "end": 27.376
  }
 ],
