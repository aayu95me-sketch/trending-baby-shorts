 "lines": [
  {
   "start": 0.283,
   "text": "Kavya Maran aur Anirudh ki shaadi sach mein ho gayi? Ya phir se afwaah?",
   "end": 3.672
  },
  {
   "start": 4.067,
   "text": "Is baar pakka. Anirudh ne khud Instagram par shaadi ki photo daali. Greece mein, 11 NOV ko.",
   "end": 10.7
  },
  {
   "start": 10.7,
   "text": "Sunrisers Hyderabad ne bhi badhaai di. Wahi IPL team jiski CEO Kavya hain.",
   "end": 14.864
  },
  {
   "start": 15.22,
   "text": "Lekin mazedaar baat. Pichhle saal Anirudh ne isi shaadi ko afwaah bataya tha.",
   "end": 19.088
  },
  {
   "start": 19.5,
   "text": "Jo ab bhi bole fake news hai, use yeh bhejo.",
   "end": 21.854
  }
