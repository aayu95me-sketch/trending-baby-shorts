 "lines": [
  {
   "start": 0.201,
   "text": "Mexico ke aasmaan mein udta dinosaur? Video asli hai ya AI?",
   "end": 3.726
  },
  {
   "start": 3.72,
   "text": "Video Mexico ke Ciudad Juarez shehar ka bataya ja raha hai.",
   "end": 6.753
  },
  {
   "start": 7.025,
   "text": "Lekin Snopes ne sabse viral clip ko fake paaya. Peeche building ke akshar badalte rehte hain, yeh AI ki pehchaan hai.",
   "end": 12.681
  },
  {
   "start": 12.925,
   "text": "Juarez Civil Protection ne bhi kaha, iska koi asli aadhaar nahi.",
   "end": 15.941
  },
  {
   "start": 16.32,
   "text": "Aur pterodactyl lagbhag 66 million saal pehle khatam ho chuke hain.",
   "end": 19.241
  },
  {
   "start": 19.7,
   "text": "Twist yeh, ki woh dinosaur the hi nahi. Udne wale reptile the.",
   "end": 22.87
  },
  {
   "start": 23.004,
   "text": "Aisa video aaye toh background dekho. Aapko kya laga, asli ya AI? Comment karo.",
   "end": 27.612
  }
 ],
