 "lines": [
  {
   "start": 0.293,
   "text": "Duniya ki sabse badi chip company Nvidia ke boss, aur ek jasoos? Alice Huang kaun hai?",
   "end": 6.315
  },
  {
   "start": 6.719,
   "text": "Alice Huang, Singapore ki chip company Megaspeed ki executive.",
   "end": 10.424
  },
  {
   "start": 10.747,
   "text": "Ek memo ka daawa, China ne unhe Jensen Huang par nazar rakhne bheja. Lekin yeh saabit nahi hua.",
   "end": 16.135
  },
  {
   "start": 16.526,
   "text": "Reports ke mutabik Jensen ne affair maana, aur Nvidia board ne jaanch shuru ki.",
   "end": 20.799
  },
  {
   "start": 21.199,
   "text": "Board kehta hai, raaz leak hone ka koi sabut nahi. Sach share karo, update ke liye follow karo.",
   "end": 26.04
  }
 ],
