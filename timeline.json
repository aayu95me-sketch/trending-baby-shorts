 "lines": [
  {
   "start": 0.113,
   "text": "Naya AI aaya, Claude Fable 5.2 . Kya yeh sach mein GPT aur Gemini se aage hai?",
   "end": 5.9
  },
  {
   "start": 6.32,
   "text": "Anthropic ne nau November ko launch kiya. Saath mein Mythos, wahi model, par sirf verified security aur science labs ke liye.",
   "end": 13.536
  },
  {
   "start": 13.636,
   "text": "Coding test mein Fable ko 49% mile. GPT ko 43% . Aur Gemini ko 41% .",
   "end": 19.574
  },
  {
   "start": 19.898,
   "text": "Lekin dhyan do, yeh number Anthropic ne khud diye hain. Bahar ki jaanch abhi baaki hai.",
   "end": 24.343
  },
  {
   "start": 24.68,
   "text": "Paid plans aur API par mil raha hai, aur API 20% sasta.",
   "end": 28.492
  },
  {
   "start": 28.819,
   "text": "Aap kaunsa AI use karte ho? Comment karo.",
   "end": 30.74
  }
 ],
