{
 "total": 42.161,
 "voice": "20261117-census-self-form/voice.wav",
 "lines": [
  {
   "start": 0.106,
   "text": "Census toh 2027 mein hona tha. Phir UP aur Punjab mein abhi form kyun bhar rahe hain?",
   "end": 4.617
  },
  {
   "start": 5.0,
   "text": "Kyunki UP, Punjab, Goa aur Uttarakhand mein agle saal chunav hain. Isliye wahan ginti pehle ho rahi hai.",
   "end": 10.354
  },
  {
   "start": 10.56,
   "text": "Solah se tees November tak aap ghar baithe khud online form bhar sakte ho. Ise self enumeration kehte hain.",
   "end": 15.761
  },
  {
   "start": 16.1,
   "text": "Website hai s e dot census dot gov dot in. Mobile OTP daalo, phir ghar ke sab logon ki details.",
   "end": 22.359
  },
  {
   "start": 22.461,
   "text": "Submit karte hi ek SE ID milegi. Use sambhaal ke rakhna.",
   "end": 26.473
  },
  {
   "start": 26.58,
   "text": "Ek December se chaar January tak karmachari ghar aayenge. Unhe yeh ID dikhao, details wahin se mil jaayengi.",
   "end": 31.523
  },
  {
   "start": 31.875,
   "text": "Zaroori nahi hai. Online nahi bhara, toh karmachari ghar aakar poochenge. Is baar jaati bhi poochi jaayegi.",
   "end": 37.92
  },
  {
   "start": 37.92,
   "text": "Apne UP, Punjab wale dost ko yeh video bhejo.",
   "end": 40.706
  }
 ],
