 "lines": [
  {
   "start": 0.307,
   "text": "Barah crore ka Diwali Bumper result aa gaya. Par aapka number lagne ka asli chance kitna tha?",
   "end": 5.371
  },
  {
   "start": 5.716,
   "text": "Suno kul chhattees lakh ticket chhape gaye. Aur barah crore wala pehla inaam sirf ek.",
   "end": 10.958
  },
  {
   "start": 11.359,
   "text": "Matlab chhattees lakh mein ek chance. Ek poore bade shehar mein sirf ek aadmi.",
   "end": 15.699
  },
  {
   "start": 16.08,
   "text": "Inaam kul lagbhag do lakh hain. Par inme se zyadatar sirf hazaar rupaye wale.",
   "end": 19.953
  },
  {
   "start": 20.303,
   "text": "Paise ka hisaab dekho. Saare ticket bike toh log ek sau assi crore lagaayenge. Inaam mein bante lagbhag adtaalees crore.",
   "end": 26.295
  },
  {
   "start": 26.51,
   "text": "Aur jeetne wale ko bhi poore barah crore nahi milte. Tees pratishat TDS pehle hi kat jaata hai.",
   "end": 31.199
  },
  {
   "start": 31.318,
   "text": "Check karte waqt series aur number dono milne chahiye. Aur claim tees din ke andar.",
   "end": 36.102
  },
  {
   "start": 36.495,
   "text": "Aap phir bhi ticket loge? Comment karo.",
   "end": 38.694
  }
 ],
