{
 "total": 41.468,
 "voice": "20261118-dhoni-retires/voice.wav",
 "lines": [
  {
   "start": 0.199,
   "text": "Dhoni ne sach mein IPL chhod diya? Ya CSK ne unhe release kar diya?",
   "end": 4.36
  },
  {
   "start": 4.62,
   "text": "Haan retire ho gaye. Retention ke din CSK ne khud announce kiya, ab Dhoni player nahi, team ke mentor honge.",
   "end": 7.56
  },
  {
   "start": 7.56,
   "text": "Release mein naam isliye aaya, kyunki woh ab khiladi nahi rahe. CSK ne unhe nikaala nahi.",
   "end": 17.462
  },
  {
   "start": 17.462,
   "text": "Aakhri match unhone May 2025 mein khela tha. Pichhle season ek bhi match nahi khela.",
   "end": 21.267
  },
  {
   "start": 21.553,
   "text": "CSK ke liye paanch IPL trophy, aur franchise ke liye sabse zyada match.",
   "end": 26.86
  },
  {
   "start": 26.86,
   "text": "Co-owner Rupa Gurunath ne kaha, MS mentor ban kar CSK family ka hissa rahenge.",
   "end": 30.76
  },
  {
   "start": 30.76,
   "text": "Aage Ruturaj Gaikwad aur Sanju Samson retain hue.",
   "end": 33.949
  },
  {
   "start": 34.294,
   "text": "Thala ka sabse yaadgaar pal kaunsa tha? Comment karo, aur us dost ko bhejo jo soch raha tha Dhoni ko nikaal diya.",
   "end": 40.069
  }
 ],
