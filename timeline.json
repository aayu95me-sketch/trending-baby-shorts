  {
   "start": 0.179,
   "text": "Andhra ke Deputy CM Pawan Kalyan ka divorce? Sach kya hai?",
   "end": 3.5
  },
  {
   "start": 3.86,
   "text": "Nau November ko Pawan aur Anna ne saath mein statement diya: hum alag ho rahe hain, aapsi samajh aur izzat ke saath.",
   "end": 9.949
  },
  {
   "start": 10.24,
   "text": "Bachchon ki khushi dono ki saanjhi zimmedari. Aur dono acche dost rahenge.",
   "end": 14.0
  },
  {
   "start": 14.0,
   "text": "Lekin kya court mein divorce file hua? Iski koi official pushti nahi hai.",
   "end": 18.255
  },
  {
   "start": 18.791,
   "text": "Afwah nahi, sach share karo.",
   "end": 20.184
  }
