   "start": 0.332,
   "text": "India 89 par all out. Kya yeh India ka sabse kam score hai?",
   "end": 4.007
  },
  {
   "start": 4.48,
   "text": "Nahi bilkul nahi. Sabse kam 54 hai, Sharjah mein, Sri Lanka ke khilaaf.",
   "end": 9.094
  },
  {
   "start": 9.4,
   "text": "Lekin yeh haar record ke bilkul paas thi. 244 RUN se haare.",
   "end": 13.83
  },
  {
   "start": 14.011,
   "text": "India ki sabse badi haar 245 RUN ki hai, usi Sharjah wale match mein.",
   "end": 18.156
  },
  {
   "start": 18.54,
   "text": "Sirf ek run se woh record bacha.",
   "end": 20.439
  },
  {
   "start": 20.674,
   "text": "Sharjah wala match yaad hai aapko? Comment mein batao.",
   "end": 23.368
  }
