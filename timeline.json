 "lines": [
  {
   "start": 0.252,
   "text": "Train tak chhodne gaye, aur 36000 rupaye ka fine?",
   "end": 3.076
  },
  {
   "start": 3.474,
   "text": "Kanpur Central pe baarah log Varanasi-New Delhi Vande Bharat mein saamaan chadhaane ghuse.",
   "end": 8.034
  },
  {
   "start": 8.403,
   "text": "Darwaze automatic hain. Band hue, aur train chal padi.",
   "end": 10.955
  },
  {
   "start": 11.15,
   "text": "Agla rukna seedha Etawah mein hua, kareeb dedh ghante baad.",
   "end": 15.035
  },
  {
   "start": 15.035,
   "text": "Wahan RPF ne sabko utaara, aur har ek pe 3000 rupaye fine laga.",
   "end": 18.202
  },
  {
   "start": 18.577,
   "text": "Kyun bhai? Railway ka niyam hai, train chalne ke baad bina ticket waale ko poore safar ka kiraya aur penalty dena padta hai.",
   "end": 24.614
  },
  {
   "start": 24.88,
   "text": "Saamaan darwaze tak do, andar mat jao. Aapke saath kabhi hua? Comment karo, aur us dost ko bhejo jo har baar train tak chhodne jaata hai.",
   "end": 31.534
  }
 ],
