 "lines": [
  {
   "start": 0.117,
   "text": "Pichhle match mein India 89 par all out. Aur aaj series jeet li? Kaise?",
   "end": 4.622
  },
  {
   "start": 5.08,
   "text": "Haan India ne paanchwa ODI 22 RUN se jeeta. Series teen-ek se India ki.",
   "end": 9.033
  },
  {
   "start": 9.5,
   "text": "Lekin batting phir fail. Poori team sirf 209 par simat gayi.",
   "end": 12.744
  },
  {
   "start": 13.06,
   "text": "Phir pacers ne match palta. New Zealand 119 par chhe wicket kho baithi.",
   "end": 16.849
  },
  {
   "start": 17.231,
   "text": "Debut karne wale Yash Thakur ne Foxcroft ko bowled kiya, aur Arshdeep ne teen wicket liye.",
   "end": 21.68
  },
  {
   "start": 22.02,
   "text": "Aur suno. New Zealand ghar par lagataar 11 ODI series jeeti thi. Wo streak India ne todi.",
   "end": 26.633
  },
  {
   "start": 27.038,
   "text": "Toh kya ab navaasi wali haar maaf? Comment karo.",
   "end": 29.197
  }
 ],
