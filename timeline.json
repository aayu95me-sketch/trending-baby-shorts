 "voice": "20261117-pattinson-bond/voice.wav",
 "lines": [
  {
   "start": 0.0,
   "text": "Twilight wala vampire ab James Bond? Sach mein?",
   "end": 2.853
  },
  {
   "start": 3.3,
   "text": "Haan pakka. Amazon MGM Studios ne aaj officially Robert Pattinson ko naya double o seven announce kiya.",
   "end": 8.888
  },
  {
   "start": 9.3,
   "text": "Woh Bond banne wale saatve actor honge, aur Daniel Craig ki jagah lenge.",
   "end": 12.051
  },
  {
   "start": 12.44,
   "text": "Film direct karenge Dune wale Denis Villeneuve. Script likhenge Peaky Blinders wale Steven Knight.",
   "end": 16.582
  },
  {
   "start": 16.966,
   "text": "Race mein Callum Turner, Josh O'Connor aur Nicholas Hoult jaise naam the. Bazi Pattinson ne maari.",
   "end": 22.089
  },
  {
   "start": 22.52,
   "text": "Kab aayegi? Shooting agle saal shuru hone ki ummeed hai, aur release 2028 se pehle nahi.",
   "end": 27.123
  },
  {
   "start": 27.5,
   "text": "Pattinson ne kaha, double o seven milna zindagi ka sabse bada samman hai.",
   "end": 31.215
  },
  {
   "start": 31.613,
   "text": "Batman ke baad Bond. Sahi choice ya galat? Comment karo.",
   "end": 35.491
  }
 ],
