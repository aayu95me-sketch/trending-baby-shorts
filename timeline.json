  },
  {
   "start": 4.68,
   "text": "India jeeta, 2-1 se. Dhaka mein SAFF Championship ka final.",
   "end": 8.284
  },
  {
   "start": 8.483,
   "text": "Yeh India ka dasvaan SAFF title hai. Kisi bhi team se zyada.",
   "end": 11.347
  },
  {
   "start": 11.74,
   "text": "Pakistan pehli baar SAFF final mein pahuncha tha, semi final mein host Bangladesh ko hara kar.",
   "end": 15.881
  },
  {
   "start": 16.0,
   "text": "Aur isi tournament ke group match mein bhi India ne Pakistan ko 3-2 se haraya tha. Yaani do baar.",
   "end": 21.017
  },
  {
