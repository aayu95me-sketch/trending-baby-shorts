{
 "total": 66.068,
 "voice": "long-gta6-hisaab/ch6/voice.wav",
 "lines": [
  {
   "start": 0.317,
   "text": "Chapter paanch. Mahine aur ghante ka hisaab.",
   "end": 2.539
  },
  {
   "start": 2.539,
   "text": "Sattar hazaar ek saath bhaari lagte hain. Agar aap baarah mahine ki no cost EMI pe lo, to ₹5,916 mahina. EMI offer bank aur dukaan ke hisaab se badalte hain, isliye ye sirf hisaab hai.",
   "end": 14.325
  },
  {
   "start": 14.828,
   "text": "Ab ek aur tareeka. Maan lo aap saal bhar roz ek ghanta khelte ho. Matlab 365 ghante.",
   "end": 21.06
  },
  {
   "start": 21.154,
   "text": "Poora setup, ₹70,989 , ka matlab lagbhag ₹194 rupaye ghanta.",
   "end": 25.734
  },
  {
   "start": 25.956,
   "text": "Aur agar PS5 pehle se hai, to sirf game ka kharcha ₹16 rupaye ghanta. Ek chai se bhi kam.",
   "end": 32.266
  },
  {
   "start": 32.72,
   "text": "Aur agar aap sirf weekend gamer ho? Saturday aur Sunday do-do ghante. Matlab hafte mein chaar ghante, saal mein 208 ghante. Tab poora setup lagbhag ₹341 rupaye ghanta padta hai, aur sirf game lagbhag ₹29 rupaye ghanta.",
   "end": 47.23
  },
  {
   "start": 47.829,
   "text": "Aur PS5 pe aap baaki games bhi kheloge, to asli per ghanta kharcha isse bhi kam hoga.",
   "end": 53.464
  },
  {
   "start": 53.464,
   "text": "Aur ek desi jugaad. Teen dost milke ek PS5 aur ek game lo, aur baari baari se khelo. Har ek ka hissa ₹23,663 . Bas ye pehle tay kar lena ki Saturday raat kiski baari hai.",
   "end": 64.716
  }
 ],
