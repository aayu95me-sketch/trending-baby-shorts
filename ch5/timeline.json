{
 "total": 73.48,
 "voice": "long-gta6-hisaab/ch5/voice.wav",
 "lines": [
  {
   "start": 0.0,
   "text": "Chapter chaar. PC ka wait karein?",
   "end": 2.695
  },
  {
   "start": 3.04,
   "text": "Bahut log keh rahe hain, main PC pe khelunga. Problem ye hai ki Rockstar ne PC version ki koi date nahi di. Agle saal ki shuruaat wali baat sirf afwaah hai.",
   "end": 12.508
  },
  {
   "start": 12.651,
   "text": "Itihaas dekho. GTA five console pe September 2013 mein aaya tha. PC pe April 2015 mein. Yaani lagbhag 19 mahine baad.",
   "end": 22.359
  },
  {
   "start": 22.638,
   "text": "Agar Rockstar wahi gap dohraye, to GTA six PC pe lagbhag June 2028 ke aas paas aayega. Ye prediction nahi, sirf pichhla pattern hai.",
   "end": 32.428
  },
  {
   "start": 33.0,
   "text": "Rockstar ka doosra bada game dekho, Red Dead Redemption two. Console pe October 2018 , PC pe November 2019 . Yaani lagbhag 13 mahine.",
   "end": 42.309
  },
  {
   "start": 42.63,
   "text": "Toh dono pattern milaao, to GTA six PC pe kahin December 2027 se June 2028 ke beech aa sakta hai. Phir se, ye sirf pattern hai, Rockstar ki date nahi.",
   "end": 53.325
  },
  {
   "start": 53.736,
   "text": "Aur PC ke liye graphics card kitna chahiye, ye bhi abhi official nahi hai. Internet pe jo specs ghoom rahe hain, wo purane leak hain.",
   "end": 61.404
  },
  {
   "start": 61.404,
   "text": "Toh seedhi baat: agar aapke paas pehle se strong gaming PC hai aur aap dedh-do saal ruk sakte ho, to wait theek hai. Warna wait ka matlab hai, sab dost khelenge aur aap spoiler dekhoge.",
   "end": 72.036
  }
 ],
