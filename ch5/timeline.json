{
 "total": 69.22,
 "voice": "long-ramayana-hisaab/ch5/voice.wav",
 "lines": [
  {
   "start": 0.201,
   "text": "Chapter chaar. Kaunse records tootenge?",
   "end": 2.537
  },
  {
   "start": 2.955,
   "text": "Ab ye list dekho. Indian filmon ki sabse badi worldwide kamai. Dangal 2,070 crore. Dhurandhar two, 1,813 . Baahubali two, 1,788 . Pushpa two, 1,742 . Aur Ramayana terah din mein 1,483 pe, number paanch pe. RRR, KGF two aur pehli Dhurandhar ko pehle hi peeche chhod chuki hai.",
   "end": 22.992
  },
  {
   "start": 23.266,
   "text": "Humare dheeme case mein bhi Ramayana 1,890 tak jaati hai. Yaani Dhurandhar two, Baahubali two aur Pushpa two, teeno ko paar. Number do pakka dikh raha hai.",
   "end": 33.061
  },
  {
   "start": 33.301,
   "text": "Aur Dangal? Beech wala case lagbhag 2,075 . Dangal 2,070 . Bas paanch crore ka farak. Ye sach mein sikka uchhaalne jaisa hai.",
   "end": 43.125
  },
  {
   "start": 43.125,
   "text": "Lekin yahan ek twist hai. Dangal ke 2,070 crore mein se 1,535 crore videsh se aaye the, aur unka bada hissa China se. India ke andar Dangal ki gross kamai lagbhag 535 crore thi.",
   "end": 55.0
  },
  {
   "start": 55.0,
   "text": "Ramayana India mein terah din mein 981 crore gross kar chuki hai. Matlab India ke andar, Ramayana Dangal se pehle hi lagbhag do guna aage hai. Worldwide record ke liye usse ya to China jaisa market chahiye, ya teesre-chauthe hafte mein mazboot rehna padega.",
   "end": 67.803
  }
 ],
