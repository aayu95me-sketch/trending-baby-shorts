 "voice": "long-gta6-hisaab/ch8/voice.wav",
 "lines": [
  {
   "start": 0.506,
   "text": "Chapter saat. Faisla.",
   "end": 1.561
  },
  {
   "start": 2.022,
   "text": "To bahas mein ye teen number bolo.",
   "end": 3.675
  },
  {
   "start": 4.237,
   "text": "Ek: PS5 pehle se hai, to GTA six ₹5,999 ka. Ultimate ke pandrah sau extra sirf saamaan ke liye hain, kahani ke liye nahi.",
   "end": 13.278
  },
  {
   "start": 13.278,
   "text": "Do: naya lena hai, to sabse sasta tareeka hai digital PS5 plus Standard game, ₹70,989 . Dabbe mein disc hai hi nahi, toh sirf GTA ke liye disc drive pe paanch hazaar mat lagao.",
   "end": 24.851
  },
  {
   "start": 24.851,
   "text": "Teen: PC ka wait karna hai, to Rockstar ke pichhle pattern se ek se dedh saal ka wait ho sakta hai.",
   "end": 30.54
  },
  {
   "start": 30.54,
   "text": "Ab aapki baari. PS5 abhi loge, ya PC ka wait karoge? Comment mein A ya B likho. A matlab abhi PS5, B matlab PC ka wait.",
   "end": 40.106
  },
  {
   "start": 40.203,
   "text": "Aise hi har trending sawaal ka poora hisaab chahiye, to Doubt Clear subscribe kar lo.",
   "end": 44.341
  }
 ],
