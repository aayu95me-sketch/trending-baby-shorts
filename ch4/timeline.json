 "voice": "long-gta6-hisaab/ch4/voice.wav",
 "lines": [
  {
   "start": 0.0,
   "text": "Chapter teen. Do sau baarah GB ka hisaab.",
   "end": 2.604
  },
  {
   "start": 3.142,
   "text": "PlayStation store ke mutabik GTA six ke liye kam se kam 212 GB khaali jagah chahiye.",
   "end": 7.68
  },
  {
   "start": 7.68,
   "text": "Aapke PS5 mein ek TB storage hai. Matlab akela GTA poori storage ka paanchva hissa kha jaata hai. Purane games delete karne padenge.",
   "end": 16.175
  },
  {
   "start": 16.47,
   "text": "Xbox Series S wale aur dhyaan dein. Uski storage 512 GB hai. GTA akela lagbhag 41% le lega. Pehle jagah khaali karo, phir download shuru karo.",
   "end": 26.258
  },
  {
   "start": 26.78,
   "text": "Ab internet ki baat. Do sau baarah GB download karne mein kitna time lagega?",
   "end": 31.049
  },
  {
   "start": 31.622,
   "text": "Agar aapka net sau Mbps ka hai, aur poori speed milti hai, to lagbhag 4 ghante 43 minute .",
   "end": 37.557
  },
  {
   "start": 37.798,
   "text": "Chaalees Mbps ka net hai, to lagbhag 11 ghante 47 minute . Raat bhar chhod do.",
   "end": 43.778
  },
  {
   "start": 43.778,
   "text": "Chhota sa tip: PS5 ko rest mode mein chhod do. Rest mode mein bhi download chalta rehta hai, aur subah game ready milega.",
   "end": 50.41
  },
  {
   "start": 50.851,
   "text": "Aur agar aap socho ki phone ke do GB roz wale plan se hotspot karke download kar loge, to 106 din lagenge. Sach mein. Teen mahine se zyada.",
   "end": 59.81
  },
  {
   "start": 60.391,
   "text": "Toh GTA six se pehle ek achha WiFi plan bhi budget mein jodo.",
   "end": 63.472
  },
  {
   "start": 63.964,
   "text": "Lekin kya PC ke liye dedh saal rukna samajhdaari hai? Uska asli sach, agle chapter mein.",
   "end": 69.157
  }
 ],
