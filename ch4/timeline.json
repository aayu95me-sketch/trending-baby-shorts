{
 "total": 72.95,
 "voice": "long-ramayana-hisaab/ch4/voice.wav",
 "lines": [
  {
   "start": 0.0,
   "text": "Chapter teen. Aur kitna kamayegi? Humara hisaab.",
   "end": 3.783
  },
  {
   "start": 4.329,
   "text": "Ab asli kaam. Trade wale bolte hain, do hazaar crore jayegi. Kis base pe? Hum base dikhayenge.",
   "end": 10.558
  },
  {
   "start": 10.558,
   "text": "Pehle saat din mein India net 511 crore aaya. Agle saat din mein, Wednesday ki advance booking jod ke, lagbhag 337 crore. Yaani doosre hafte ne pehle hafte ka 66 pratishat rakha. Badi filmon ke liye ye mazboot hold hai.",
   "end": 24.461
  },
  {
   "start": 24.679,
   "text": "Iske baad har hafta pichhle hafte ka kitna rakhega? Humne teen case liye. Dheema case: har hafta pichhle ka 40 pratishat. Beech ka case: 50 pratishat. Mazboot case: 55 pratishat.",
   "end": 37.788
  },
  {
   "start": 38.198,
   "text": "Dheema case mein India net lagbhag 1,070 crore pe rukti hai, aur worldwide lagbhag 1,890 crore.",
   "end": 44.181
  },
  {
   "start": 44.32,
   "text": "Beech ke case mein India net lagbhag 1,180 crore, worldwide lagbhag 2,075 crore.",
   "end": 50.178
  },
  {
   "start": 50.372,
   "text": "Mazboot case mein India net lagbhag 1,260 crore, worldwide lagbhag 2,200 crore.",
   "end": 56.166
  },
  {
   "start": 56.57,
   "text": "Isme China jaisa koi bada naya market nahi gina. Aur videsh ki kamai thodi dheere badhti maani hai.",
   "end": 61.918
  },
  {
   "start": 61.918,
   "text": "Ye bhavishyavani nahi hai, hisaab hai. Agar teesre hafte ka asli number humare beech wale case se neeche gira, to final number bhi neeche aayega. Hum har hafte pinned comment mein asli number se milayenge.",
   "end": 71.509
  }
 ],
