{
 "total": 46.798,
 "voice": "20261120-ps5-price-hike/voice.wav",
 "lines": [
  {
   "start": 0.0,
   "text": "Bhai dekh, yeh hai PS5, aur aaj se ismein chal raha hai GTA 6.",
   "end": 5.039
  },
  {
   "start": 5.46,
   "text": "Terah saal ke intezaar ke baad Rockstar ka naya GTA aaya hai.",
   "end": 9.074
  },
  {
   "start": 9.448,
   "text": "Vice City wapas aayi hai. Do hero, Lucia aur Jason, aur ghoomne ko poora state.",
   "end": 15.379
  },
  {
   "start": 15.635,
   "text": "Aur PS5? Four K graphics, aur SSD itni tez ki loading screen dikhti hi nahi.",
   "end": 20.659
  },
  {
   "start": 21.0,
   "text": "Controller haath mein vibrate karke batata hai gaadi kaunsi sadak pe chal rahi hai.",
   "end": 24.776
  },
  {
   "start": 25.162,
   "text": "Ab lene chalega? Isi mahine PS5 pachpan hazaar se sattar hazaar ka ho gaya.",
   "end": 30.18
  },
  {
   "start": 30.18,
   "text": "GTA ki wajah se nahi. Memory aur storage mehengi hui, US, UK, Japan mein bhi daam badhe.",
   "end": 34.353
  },
  {
   "start": 34.76,
   "text": "Game milaake lagbhag chhihattar hazaar. Sirf hike ke paison mein GTA ki dhai copies aa jaati.",
   "end": 40.101
  },
  {
   "start": 40.46,
   "text": "Tu lega ya wait karega? Comment kar, aur us dost ko bhej jo bolta hai game bachchon ka khel hai.",
   "end": 45.444
  }
 ],
