{
 "total": 47.516,
 "voice": "20261120-ananya-birla/voice.wav",
 "lines": [
  {
   "start": 0.16,
   "text": "Farah Khan ke cook ko ek lakh ki ghadi gift? Yeh Ananya Birla kaun hai?",
   "end": 4.631
  },
  {
   "start": 4.988,
   "text": "Yeh Kumar Mangalam Birla ki sabse badi beti hain, Aditya Birla Group wale.",
   "end": 8.527
  },
  {
   "start": 8.914,
   "text": "Satrah saal ki umar mein unhone apni microfinance company Svatantra shuru ki.",
   "end": 12.297
  },
  {
   "start": 12.531,
   "text": "Singer bhi hain. Unka pehla gaana Meant to Be platinum hua tha.",
   "end": 15.915
  },
  {
   "start": 16.08,
   "text": "Is hafte woh Ananya Panday ke saath Koffee With Karan pe aayi, aur Farah ke vlog mein apna Mumbai ghar dikhaya.",
   "end": 21.0
  },
  {
   "start": 21.0,
   "text": "Ab paisa. Unki apni net worth ka koi official number nahi. Reports hazaar se satrah sau crore batati hain.",
   "end": 27.8
  },
  {
   "start": 27.8,
   "text": "Asli daulat papa ki hai. Forbes ke hisaab se chaubees billion dollar, yaani do lakh crore se zyada.",
   "end": 34.546
  },
  {
   "start": 34.931,
   "text": "Toh ek lakh ki ghadi unke liye? Aapke paas ek lakh ho, toh yeh zyada se zyada ek rupaye ka gift hai.",
   "end": 40.326
  },
  {
   "start": 40.725,
   "text": "Aap unki jagah hote toh kya gift karte? Comment karo, aur us dost ko bhejo jo kehta hai ameer log kanjoos hote hain.",
   "end": 46.01
  }
 ],
