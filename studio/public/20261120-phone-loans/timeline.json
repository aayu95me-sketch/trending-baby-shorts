{
 "total": 44.796,
 "voice": "20261120-phone-loans/voice.wav",
 "lines": [
  {
   "start": 0.114,
   "text": "Ruko ruko! EMI pe phone lene wale ho? Pehle yeh number suno.",
   "end": 3.82
  },
  {
   "start": 4.213,
   "text": "Is Diwali har sau mein se chauhattar loan sirf phone ke liye the. Lentra ka data, aaj Business Today mein.",
   "end": 9.674
  },
  {
   "start": 9.92,
   "text": "Average loan lagbhag atthais hazaar ka.",
   "end": 11.88
  },
  {
   "start": 12.158,
   "text": "Aur sau mein baasath lene wale pentees saal se kam umar ke.",
   "end": 14.878
  },
  {
   "start": 15.032,
   "text": "Ab hisaab. Pandrah percent byaaj pe saal bhar, har mahine pachchees sau se upar.",
   "end": 20.02
  },
  {
   "start": 20.02,
   "text": "Total tees hazaar se zyada. Do hazaar se upar sirf byaaj, aur phone ki keemat har mahine girti hai.",
   "end": 26.37
  },
  {
   "start": 26.661,
   "text": "Toh seedhi baat. Phone se kamaai hoti hai, kaam ke liye zaroori hai, toh lo.",
   "end": 30.712
  },
  {
   "start": 31.1,
   "text": "Sirf dikhane ke liye? Mat lo. Teen mahine bachao, cash mein lo, aur byaaj ke paise jeb mein rakho.",
   "end": 36.924
  },
  {
   "start": 37.264,
   "text": "Aapne kya kiya, cash ya EMI? Comment karo, aur us dost ko bhejo jo agle hafte EMI pe phone lene wala hai.",
   "end": 43.385
  }
 ],
