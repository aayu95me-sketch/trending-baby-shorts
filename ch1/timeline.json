 "lines": [
  {
   "start": 0.0,
   "text": "GTA six aa gaya. Aur internet pe sabse zyada ek hi sawaal search ho raha hai: GTA six price in India.",
   "end": 7.3
  },
  {
   "start": 7.3,
   "text": "Seedha jawab pehle: game ₹5,999 ka. Aur agar PS5 bhi lena hai, to poora setup ₹70,989 se shuru.",
   "end": 16.399
  },
  {
   "start": 16.399,
   "text": "Lekin ruko. Zyaadatar log isse paanch hazaar rupaye zyada de rahe hain, ek aisi cheez ke liye jo GTA ke dabbe mein hai hi nahi.",
   "end": 23.716
  },
  {
   "start": 23.716,
   "text": "Aaj hum game, console, internet, EMI aur PC ka wait, sab ka hisaab khud lagayenge. Aur end mein bataayenge GTA six khelne ka sabse sasta tareeka.",
   "end": 33.747
  }
 ],
