 "voice": "long-ramayana-hisaab/ch7/voice.wav",
 "lines": [
  {
   "start": 0.578,
   "text": "Chapter chhe. Faisla.",
   "end": 1.968
  },
  {
   "start": 2.312,
   "text": "To bahas mein ye teen baatein bolo.",
   "end": 5.055
  },
  {
   "start": 5.055,
   "text": "Ek: terah din mein 1,483 crore, aur humare dheeme hisaab mein bhi ye Dhurandhar two ko paar karke India ki number do film banegi.",
   "end": 14.265
  },
  {
   "start": 14.265,
   "text": "Do: Dangal ka worldwide record bilkul kaante ki takkar hai. Lekin India ke andar Ramayana pehle hi Dangal se do guna aage hai.",
   "end": 23.0
  },
  {
   "start": 23.0,
   "text": "Teen: chaar hazaar crore Part one se wapas nahi aayenge, aur aana bhi nahi tha. Part one film wale tak lagbhag 1,300 crore laayega. Baaki ka hisaab Part two karega.",
   "end": 33.445
  },
  {
   "start": 33.445,
   "text": "Ab aapki baari. Teesre hafte mein Ramayana India mein kitna net karegi? Apna number comment mein likho. Agle hafte hum asli number se milayenge, aur jiska sabse paas hoga, uska naam pinned comment mein.",
   "end": 45.183
  },
  {
   "start": 45.765,
   "text": "Aise hi har trending sawaal ka hisaab chahiye to Doubt Clear subscribe kar lo.",
   "end": 49.861
  }
 ],
