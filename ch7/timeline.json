{
 "total": 68.706,
 "voice": "long-gta6-hisaab/ch7/voice.wav",
 "lines": [
  {
   "start": 0.0,
   "text": "Chapter chhe. Duniya mein kya hua.",
   "end": 1.611
  },
  {
   "start": 1.611,
   "text": "Pehle kahani. GTA six mein do lead hain, Jason Duval aur Lucia Caminos. Ye pehla numbered GTA hai jisme female lead hai. Game Leonida mein set hai, jo Florida ka nakli roop hai, aur saath mein naya Vice City. Reports ke mutabik map GTA five se lagbhag do guna bada hai, lekin Rockstar ne official number nahi diya.",
   "end": 22.778
  },
  {
   "start": 22.778,
   "text": "Kya game paise layak hai? Critics ka jawab: haan. Metacritic pe 99 , ek sau pachaas se zyada reviews se. Ye Zelda Ocarina of Time ke 1998 wale record ki barabari hai. IGN aur GameSpot ne das mein se das diye.",
   "end": 38.736
  },
  {
   "start": 38.736,
   "text": "Paisa bhi barsa. Sensor Tower ke andaaze se launch se pehle hi lagbhag 17.07 million digital pre-order, aur $1.65 billion ki kamai. Ye andaaze hain, Rockstar ne official number abhi nahi diye.",
   "end": 51.645
  },
  {
   "start": 51.645,
   "text": "Lekin sab kuch perfect nahi. Launch se ek din pehle PSN down hua. Kuch players ne prologue mein crash, Lucia ke shuruaati mission mein game atakna, aur gaadiyon ki ajeeb physics ki shikaayat ki.",
   "end": 62.776
  },
  {
   "start": 62.776,
   "text": "Aur console pe game tees frame per second pe locked hai. Reviewers ki sabse badi shikaayat yahi rahi.",
   "end": 67.357
  }
 ],
